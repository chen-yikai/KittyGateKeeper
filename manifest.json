{
  "manifest_version": 3,
  "name": "Kitty Gatekeeper",
  "version": "1.0",
  "description": "限制使用Google搜尋引擎、禁用Google AI搜尋功能、禁用各種AI工具",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "tabs", "webRequest"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://google.com/*",
    "*://www.bing.com/*",
    "*://bing.com/*",
    "*://duckduckgo.com/*",
    "*://www.duckduckgo.com/*",
    "*://search.yahoo.com/*",
    "*://perplexity.ai/*",
    "*://www.perplexity.ai/*",
    "*://you.com/*",
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
